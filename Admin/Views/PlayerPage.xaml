<UserControl x:Class="me.cqp.luohuaming.iKun.Admin.Views.PlayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:me.cqp.luohuaming.iKun.Admin.Views"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <local:DateTimeDashConverter x:Key="DateTimeDashConverter" />
        <local:BigNumberConverter x:Key="BigNumberConverter" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：玩家列表 + 筛选 + 刷新 -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <hc:TextBox x:Name="SearchBox"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            hc:InfoElement.Placeholder="输入 QQ 数字筛选"
                            TextChanged="SearchBox_TextChanged" />
                <Button x:Name="RefreshButton"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           MinWidth="64"
                           Content="刷新"
                           Click="RefreshButton_Click" />
            </Grid>

            <DataGrid x:Name="PlayerGrid"
                         Grid.Row="1"
                         Margin="0,8,0,0"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         HeadersVisibility="Column"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         SelectionChanged="PlayerGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="QQ" Width="90" Binding="{Binding QQ}" />
                    <DataGridTextColumn Header="注册时间" Width="140"
                                        Binding="{Binding CreateAt, Converter={StaticResource DateTimeDashConverter}}" />
                    <DataGridTextColumn Header="最后签到" Width="140"
                                        Binding="{Binding LoginAt, Converter={StaticResource DateTimeDashConverter}}" />
                    <DataGridTextColumn Header="金币" Width="80"
                                        Binding="{Binding Coin, Converter={StaticResource BigNumberConverter}}" />
                    <DataGridTextColumn Header="鲲蛋" Width="80"
                                        Binding="{Binding KunEgg, Converter={StaticResource BigNumberConverter}}" />
                    <DataGridTextColumn Header="渡劫丹" Width="55" Binding="{Binding AscendPillComsume}" />
                    <DataGridTextColumn Header="鲲数量" Width="55" Binding="{Binding KunCount}" />
                    <DataGridTextColumn Header="存活鲲" Width="55" Binding="{Binding AliveKunCount}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 右侧：所选玩家详情 -->
        <Grid Grid.Column="1">
            <!-- 未选中时的占位提示 -->
            <TextBlock x:Name="EmptyHint"
                       Text="请从左侧列表选择一位玩家查看详情"
                       FontSize="16"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <!-- 详情面板 -->
            <Grid x:Name="DetailHost" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="DetailHeader"
                           Grid.Row="0"
                           Margin="0,0,0,8"
                           FontSize="16"
                           FontWeight="Bold" />

                <GroupBox Grid.Row="1" Header="基本信息（可编辑）" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                            <TextBlock Margin="0,0,0,4" Text="最后签到（yyyy-MM-dd HH:mm:ss，留空为未设置）" />
                            <hc:TextBox x:Name="LoginAtBox" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Margin="0,0,0,4" Text="攻击冷却到期（清空/重置攻击冷却）" />
                            <hc:TextBox x:Name="AttackAtBox" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Margin="0,0,0,4" Text="吞噬冷却到期（清空/重置吞噬冷却）" />
                            <hc:TextBox x:Name="DevourAtBox" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Margin="0,0,0,4" Text="挂起渡劫丹（下次渡劫的成功率加成次数）" />
                            <hc:TextBox x:Name="AscendPillBox" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="背包（可编辑数量）" Padding="8" Margin="0,0,0,8">
                    <DataGrid x:Name="InventoryGrid"
                                 AutoGenerateColumns="False"
                                 HeadersVisibility="Column"
                                 CanUserAddRows="False"
                                 CanUserDeleteRows="False"
                                 MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="物品" Width="*" IsReadOnly="True" Binding="{Binding Name}" />
                            <DataGridTemplateColumn Header="数量" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Margin="2"
                                                 Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Grid.Row="3" Header="名下鲲" Padding="8">
                    <DataGrid x:Name="KunGrid"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 SelectionMode="Single"
                                 HeadersVisibility="Column"
                                 CanUserAddRows="False"
                                 CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="等级" Width="55" Binding="{Binding Level}" />
                            <DataGridTextColumn Header="体重" Width="100" Binding="{Binding Weight}" />
                            <DataGridTextColumn Header="主词缀" Width="70" Binding="{Binding MainAffix}" />
                            <DataGridTextColumn Header="副词缀1" Width="70" Binding="{Binding Affix1}" />
                            <DataGridTextColumn Header="副词缀2" Width="70" Binding="{Binding Affix2}" />
                            <DataGridTextColumn Header="存活" Width="45" Binding="{Binding Alive}" />
                            <DataGridTextColumn Header="弃置" Width="45" Binding="{Binding Abandoned}" />
                            <DataGridTextColumn Header="可复活" Width="55" Binding="{Binding CanResurrect}" />
                            <DataGridTextColumn Header="死亡时间" Width="140" Binding="{Binding DeadAt}" />
                            <DataGridTextColumn Header="昵称" Width="*" Binding="{Binding NickName}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <StackPanel Grid.Row="4"
                            Margin="0,10,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" MinWidth="110" Content="保存修改" Click="SaveButton_Click" />
                    <Button x:Name="DeleteButton" MinWidth="110" Margin="8,0,0,0" Content="删除玩家" Click="DeleteButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

