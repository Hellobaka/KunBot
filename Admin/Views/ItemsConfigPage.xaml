<UserControl x:Class="me.cqp.luohuaming.iKun.Admin.Views.ItemsConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentPanel" Margin="4" />
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,8,4,0">
            <Button x:Name="ReloadButton" Content="重新加载" Width="80" Height="30" Click="ReloadButton_Click" />
            <Button x:Name="SaveButton" Content="保存" Width="80" Height="30" Margin="8,0,0,0" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
