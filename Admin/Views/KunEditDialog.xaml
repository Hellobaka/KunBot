<hc:Window x:Class="me.cqp.luohuaming.iKun.Admin.Views.KunEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="编辑鲲"
        Width="680"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 基础信息 -->
        <GroupBox Grid.Row="0" Header="基础信息">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="等级" VerticalAlignment="Center" Margin="0,0,0,8" />
                <hc:WatermarkTextBox Grid.Row="0" Grid.Column="1" x:Name="LevelBox" Margin="0,0,12,8"
                                     TextChanged="LevelOrWeight_Changed" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="体重" VerticalAlignment="Center" Margin="0,0,0,8" />
                <hc:WatermarkTextBox Grid.Row="0" Grid.Column="3" x:Name="WeightBox" Margin="0,0,0,8"
                                     TextChanged="LevelOrWeight_Changed" />

                <!-- 体重上限实时提示（超限变红） -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" x:Name="LimitHint"
                           Margin="0,0,0,8" Foreground="#FF888888" TextTrimming="CharacterEllipsis" />

                <CheckBox Grid.Row="2" Grid.Column="1" x:Name="AliveCheck" Content="存活"
                          Margin="0,0,12,8" Checked="AliveCheck_Changed" Unchecked="AliveCheck_Changed" />
                <CheckBox Grid.Row="2" Grid.Column="3" x:Name="AbandonedCheck" Content="弃置" Margin="0,0,0,8" />

                <CheckBox Grid.Row="3" Grid.Column="1" x:Name="CanResurrectCheck" Content="可复活" Margin="0,0,12,8" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="复活次数" VerticalAlignment="Center" Margin="0,0,0,8" />
                <hc:WatermarkTextBox Grid.Row="3" Grid.Column="3" x:Name="ResurrectCountBox" Margin="0,0,0,8" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="死亡日期" VerticalAlignment="Center" Margin="0,0,0,8" />
                <DatePicker Grid.Row="4" Grid.Column="1" x:Name="DeadDate" Margin="0,0,12,8" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="死亡时间" VerticalAlignment="Center" Margin="0,0,0,8" />
                <hc:WatermarkTextBox Grid.Row="4" Grid.Column="3" x:Name="DeadTimeBox" Margin="0,0,0,8"
                                     Watermark="HH:mm，留空表示不变" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="昵称" VerticalAlignment="Center" Margin="0,0,0,8" />
                <hc:WatermarkTextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" x:Name="NickNameBox"
                                     Watermark="留空 = 恢复默认名" />
            </Grid>
        </GroupBox>

        <!-- 词缀 -->
        <GroupBox Grid.Row="1" Header="词缀" Margin="0,12,0,0">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="主词缀" VerticalAlignment="Center" Margin="0,0,0,8" />
                <hc:ComboBox Grid.Row="0" Grid.Column="1" x:Name="MainCombo" Margin="0,0,0,8"
                             DisplayMemberPath="Display" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="副词缀1" VerticalAlignment="Center" Margin="0,0,0,8" />
                <hc:ComboBox Grid.Row="1" Grid.Column="1" x:Name="SubBCombo" Margin="0,0,0,8"
                             DisplayMemberPath="Display" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="副词缀2" VerticalAlignment="Center" Margin="0,0,0,8" />
                <hc:ComboBox Grid.Row="2" Grid.Column="1" x:Name="SubCCombo" DisplayMemberPath="Display" />
            </Grid>
        </GroupBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="取消" Padding="18,0" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Content="保存" Padding="18,0" IsDefault="True"
                    Style="{DynamicResource PrimaryButton}" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</hc:Window>
